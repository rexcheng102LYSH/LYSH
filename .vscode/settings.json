{
    "chatgpt.openOnStartup": true,
    "chatgpt.commentCodeLensEnabled": false,
    "task.allowAutomaticTasks": "on",
    "files.encoding": "utf8",
    "workbench.localHistory.enabled": true,
    "workbench.localHistory.maxFileEntries": 200,

    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 1000,
    "files.watcherExclude": {
        "**/auto_backups/**": true,
        "**/node_modules/**": true,
        "**/.git/**": true,
        "**/backup/**": true,
        "**/save/**": true,
        "**/.kiro/**": true
    },

    "search.exclude": {
        "**/auto_backups/**": true,
        "**/node_modules/**": true,
        "**/backup/**": true,
        "**/save/**": true
    },

    "files.exclude": {
        "**/auto_backups/**": true
    },

    "terminal.integrated.env.windows": {
        "PATH": "${env:PATH}"
    },
    "terminal.integrated.env.linux": {
        "PATH": "${env:PATH}"
    },
    "terminal.integrated.env.osx": {
        "PATH": "${env:PATH}"
    },

    // KiloCode 索引配置（通过扩展 UI 配置，此处仅保留有效的 VS Code 配置项）
    // 如需配置索引功能，请打开 Kilo Code 扩展面板 → 点击 "Codebase Indexing" 按钮
    "kilo-code.codeIndex.embeddingBatchSize": 60,
    "kilo-code.maximumIndexedFilesForFileSearch": 10000
}
